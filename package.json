{
  "name": "coin_market_cap",
  "version": "1.0.0",
  "description": "Crypto API based on CoinMarketCap",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "dotenv -e .env.dev -- tsx app/index.ts",
    "build": "npm run clean && tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "clean": "rm -rf ./dist ./tsconfig.tsbuildinfo",
    "test": "npm run test:types && NODE_OPTIONS=--experimental-vm-modules jest",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "express": "^5.3.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#app/*": "./dist/*"
  }
